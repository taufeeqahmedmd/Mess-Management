# Copy to `.env` and fill in. Never commit `.env`.

# PostgreSQL connection (matches docker-compose.yml — host port 5433 to avoid
# clashing with any local Postgres on 5432)
DATABASE_URL="postgresql://mess:mess@localhost:5433/mess_management?schema=public"

# Auth.js (NextAuth v5) — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# Base URL of the app (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"

# IANA timezone of the cafeteria — drives meal-window matching, the once-per-meal
# session bucket, and date-versioned rate/validity (the consumption engine
# evaluates "today" / "now" against this, NOT the deploy server's clock).
# Defaults to Asia/Kolkata when unset.
APP_TIMEZONE="Asia/Kolkata"

# --- Jodo payment gateway (self-service top-up on /top-up) ---
# Basic-auth credentials from Jodo; keep these secret.
JODO_BASE_URL="https://ext.jodo.in"
JODO_USERNAME=""
JODO_PASSWORD=""
# Absolute base URL of this app, used to build the payment callback_url.
APP_URL="https://your-domain.example"

# --- Notifications module (phase 2 senders; the portal works without these,
# --- logging every notification as "skipped" until they are set) ---
# Email — one SMTP account per sending entity (Notifications → Email):
SMTP_PALLAVI_HOST=""
SMTP_PALLAVI_PORT="587"
SMTP_PALLAVI_USER=""
SMTP_PALLAVI_PASS=""
SMTP_DPS_HOST=""
SMTP_DPS_PORT="587"
SMTP_DPS_USER=""
SMTP_DPS_PASS=""
# WhatsApp Business via Smartping:
SMARTPING_BASE_URL=""
SMARTPING_API_KEY=""
# Web Push (staff/vendor PWA) — generate a VAPID key pair:
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Optional push/digest extras:
VAPID_SUBJECT="mailto:info@k-innovative.com"
SMARTPING_SENDER=""
# Secret for the daily digest flush (POST /api/notifications/digest with x-cron-secret):
CRON_SECRET=""
