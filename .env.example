# Copy to `.env` and fill in. Never commit `.env`.

# PostgreSQL connection (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://mess:mess@localhost:5432/mess_management?schema=public"

# Auth.js (NextAuth v5) — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# Base URL of the app (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"
