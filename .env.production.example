# Production environment for the single-box EC2 deploy (Option A).
# Copy to `.env` ON THE SERVER and fill in. NEVER commit the real `.env`.
# Next.js (`next start`) loads this file automatically at runtime.

# --- Database -------------------------------------------------------------
# Postgres runs in Docker on the same box, bound to 127.0.0.1:5433 only.
# Use a STRONG password (must match deploy/docker-compose.prod.yml).
DATABASE_URL="postgresql://mess:Kinn@2022@127.0.0.1:5433/mess_management?schema=public"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Generate once:  openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"

# Public HTTPS URL of the app (drives auth callbacks + secure cookies).
# Use your real subdomain once DNS is live, e.g. https://mess.yourdomain.com
AUTH_URL="https://CHANGE_ME.yourdomain.com"

# Required because the app sits behind nginx — lets Auth.js honor the
# X-Forwarded-* headers nginx sends. Without this, login/callbacks break.
AUTH_TRUST_HOST="true"

# --- App ------------------------------------------------------------------
# IANA timezone of the cafeteria. Drives meal windows / once-per-meal bucket
# / date-versioned rates. Do NOT rely on the server clock's zone.
APP_TIMEZONE="Asia/Kolkata"

# Bind port for `next start` (nginx proxies to this on localhost).
PORT="3000"
