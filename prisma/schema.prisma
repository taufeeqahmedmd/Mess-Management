// RFID Coupon / Mess Management — Prisma schema (PostgreSQL).
// Source of truth for the database; ported from db-schema.md with the documented
// MySQL→PG deltas (BIGINT IDENTITY, BOOLEAN, JSONB, native enums, timestamptz,
// @updatedAt, setting_key instead of reserved `key`).
//
// Conventions:
//  - Money is Decimal(12,2) everywhere (CLAUDE.md non-negotiable). Never float.
//  - Ledgers (wallet_transactions, coupon_transactions) are append-only.
//  - Cardholders = `users`; staff = `app_users` (login + RBAC).
//  - branch_id NULL = all-branch (Super Admin); non-null = scoped.
//  - Deferred (db-schema.md §13): coupon = count vs earmarked money — BOTH balance
//    paths kept (wallets + coupon_balances). recharge validity columns provisional.
//  - JWT sessions (Auth.js) → no `sessions` table.
//
// NOTE: Partial unique indexes (e.g. one ACTIVE card per user, one approved tap
// per meal session) are not expressible in the Prisma schema; they are added as
// raw SQL inside the relevant migration AND enforced in the service layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum BranchStatus {
  active
  inactive
}

enum AppUserStatus {
  active
  disabled
  locked
}

enum CategoryStatus {
  active
  inactive
}

enum CounterStatus {
  active
  inactive
}

enum UserStatus {
  active
  suspended
  inactive
}

enum CardStatus {
  active
  blocked
  lost
  retired
}

enum CardEventType {
  issue
  replace
  activate
  deactivate
  lost
  retire
}

enum PaidBy {
  wallet
  coupon
}

enum RechargeStatus {
  posted
  reversed
  expired
}

enum RedemptionStatus {
  posted
  reversed
}

enum TxnType {
  CR
  DR
}

enum LedgerSource {
  recharge
  redemption
  reversal
  adjustment
  expiry
}

enum ReversalSource {
  recharge
  redemption
}

enum ReversalStatus {
  pending
  approved
  rejected
}

enum SettlementStatus {
  draft
  approved
  paid
}

enum OfflineQueueStatus {
  pending
  synced
  failed
  duplicate
}

// Admin food-request workflow (plan.md §15). A request moves through an optional
// approval step, then vendor fulfilment, and is only charged at delivery once an
// RFID tap verifies the cardholder. `rejected`/`cancelled` are terminal.
enum FoodRequestStatus {
  raised
  pending_approval
  approved
  vendor_accepted
  preparing
  out_for_delivery
  delivered
  rejected
  cancelled
}

enum FoodItemKind {
  beverage
  snack
  meal
  custom
}

// ---------- Identity, access & org ----------

model Branch {
  id        BigInt       @id @default(autoincrement())
  code      String       @unique @db.VarChar(30)
  name      String       @db.VarChar(150)
  address   String?      @db.VarChar(255)
  collectorCode String?  @map("collector_code") @db.VarChar(60) // Jodo payment collector code for this branch
  emailEntityId BigInt?  @map("email_entity_id") // sending identity (Pallavi/DPS) for this branch's mail
  status    BranchStatus @default(active)
  createdBy BigInt?      @map("created_by")
  updatedBy BigInt?      @map("updated_by")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  appUsers    AppUser[]
  departments Department[]
  counters    Counter[]
  users        User[]
  mealRates    MealRate[]
  settlements  VendorSettlement[]
  settings     Setting[]
  foodItems    FoodItem[]
  foodRequests FoodRequest[]
  deliveryLocations DeliveryLocation[]
  emailEntity  EmailEntity?       @relation(fields: [emailEntityId], references: [id])

  @@map("branches")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  appUsers    AppUser[]

  @@map("roles")
}

model Permission {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(80)
  module      String  @db.VarChar(60)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           BigInt @id @default(autoincrement())
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AppUser {
  id           BigInt        @id @default(autoincrement())
  name         String        @db.VarChar(150)
  mobile       String        @unique @db.VarChar(20) // login handle (plan.md §4 — mobile + password)
  email        String?       @unique @db.VarChar(150)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  roleId       BigInt        @map("role_id")
  branchId     BigInt?       @map("branch_id") // NULL = all branches (Super Admin)
  status       AppUserStatus @default(active)
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  failedLogins Int           @default(0) @map("failed_logins")
  lockedUntil  DateTime?     @map("locked_until") @db.Timestamptz(6) // time-windowed login lockout (auto-clears); NULL = not locked
  // Optional link to this staff member's OWN RFID/cardholder account, so they can
  // raise food requests charged to themselves without searching. Staff ≠ cardholders
  // remains true — this is just a pointer, set in Settings → Staff.
  cardholderUserId BigInt?    @map("cardholder_user_id")
  // Staff whose role is Vendor / Mess Incharge belong to a vendor (set in
  // Settings → Staff). NULL for all other roles.
  vendorId     BigInt?       @map("vendor_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  role             Role               @relation(fields: [roleId], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  cardholder       User?              @relation("AppUserCardholder", fields: [cardholderUserId], references: [id])
  vendor           Vendor?            @relation("VendorStaff", fields: [vendorId], references: [id])
  counterOperators CounterOperator[]
  pushSubscriptions PushSubscription[]
  cardEvents       CardEvent[]
  recharges        Recharge[]
  redemptions      Redemption[]
  reversalsMade    Reversal[]         @relation("ReversalRequestedBy")
  reversalsApprovd Reversal[]         @relation("ReversalApprovedBy")
  auditLogs        AuditLog[]
  vendorAccount    Vendor?            @relation("VendorPortalOperator")
  foodReqRequested FoodRequest[]      @relation("FoodRequestRequestedBy")
  foodReqApproved  FoodRequest[]      @relation("FoodRequestApprovedBy")
  foodReqEvents    FoodRequestEvent[]

  @@map("app_users")
}

model Department {
  id        BigInt   @id @default(autoincrement())
  branchId  BigInt   @map("branch_id")
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id])
  users  User[]

  @@unique([branchId, name])
  @@map("departments")
}

model Category {
  id                 BigInt         @id @default(autoincrement())
  code               String         @db.VarChar(30) // human label only — NOT unique; the stable key is `id`
  name               String         @unique @db.VarChar(80)
  identifierLabel    String         @default("ID") @map("identifier_label") @db.VarChar(60)
  identifierRegex    String?        @map("identifier_regex") @db.VarChar(120)
  identifierRequired Boolean        @default(true) @map("identifier_required")
  identifierUnique   Boolean        @default(true) @map("identifier_unique")
  status             CategoryStatus @default(active)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  users     User[]
  mealRates MealRate[]
  settings  CategorySetting[]

  @@map("categories")
}

// Per-category consumption config (plan.md §6 — the mock's "System Settings").
// Each category has ONE active row deciding how its cardholders' taps resolve.
// `models` enables WALLET (deduct money), COUPON (deduct a per-meal count), or
// BOTH; when both, resolution is coupon-first then wallet. Carries that
// category's duplicate-tap window + once-per-meal-session flag.
enum ConsumptionModel {
  wallet
  coupon
}

model CategorySetting {
  id                  BigInt             @id @default(autoincrement())
  categoryId          BigInt             @map("category_id")
  models              ConsumptionModel[] // enabled models; both = coupon-first then wallet
  duplicateWindow     Int                @default(0) @map("duplicate_window") // seconds; 0 = no guard
  restrictMealSession Boolean            @default(false) @map("restrict_meal_session")
  status              CategoryStatus     @default(active) // only the active row applies
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id])

  // One ACTIVE setting per category → partial unique index added in migration SQL.
  @@index([categoryId])
  @@map("category_settings")
}

// ---------- Counters & devices ----------

model Counter {
  id        BigInt        @id @default(autoincrement())
  branchId  BigInt        @map("branch_id")
  code      String        @db.VarChar(30)
  name      String        @db.VarChar(120)
  status    CounterStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  branch      Branch            @relation(fields: [branchId], references: [id])
  operators   CounterOperator[]
  meals       CounterMeal[]
  rates       MealRate[]
  recharges   Recharge[]
  redemptions Redemption[]

  @@unique([branchId, code])
  @@map("counters")
}

// A meal a counter serves, with its own service window (one counter can serve
// several meals — breakfast, lunch, …). These per-counter windows override the
// meal's default window for taps at this counter; the tap engine resolves the
// active meal for the tap's counter (services/counter-meals.ts windowsForCounter,
// with a fallback to the global meal windows when a counter has no rows).
model CounterMeal {
  id         BigInt   @id @default(autoincrement())
  counterId  BigInt   @map("counter_id")
  mealTypeId BigInt   @map("meal_type_id")
  startTime  String   @default("00:00") @map("start_time") @db.VarChar(5) // "HH:MM"; overnight handled in service
  endTime    String   @default("00:00") @map("end_time") @db.VarChar(5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  counter  Counter  @relation(fields: [counterId], references: [id], onDelete: Cascade)
  mealType MealType @relation(fields: [mealTypeId], references: [id])

  @@unique([counterId, mealTypeId])
  @@index([mealTypeId])
  @@map("counter_meals")
}

model CounterOperator {
  id        BigInt @id @default(autoincrement())
  counterId BigInt @map("counter_id")
  appUserId BigInt @map("app_user_id")

  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([counterId, appUserId])
  @@map("counter_operators")
}

// ---------- Cardholders & cards ----------

model User {
  id              BigInt     @id @default(autoincrement())
  code            String     @unique @db.VarChar(40) // category identifier + public self-service handle
  fullName        String     @map("full_name") @db.VarChar(150)
  phone           String?    @db.VarChar(20)
  email           String?    @db.VarChar(150)
  categoryId      BigInt     @map("category_id")
  departmentId    BigInt?    @map("department_id")
  branchId        BigInt     @map("branch_id")
  photoUrl        String?    @map("photo_url") @db.VarChar(255)
  kycRef          String?    @map("kyc_ref") @db.VarChar(80)
  status          UserStatus @default(active)
  cardExpiryDate  DateTime?  @map("card_expiry_date") @db.Date // user-level validity; past this, wallet+coupons are zeroed (§6)
  validityExpired Boolean    @default(false) @map("validity_expired") // set when expiry claw-back has run
  createdBy       BigInt?    @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  category       Category            @relation(fields: [categoryId], references: [id])
  department     Department?         @relation(fields: [departmentId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [id])
  cards          RfidCard[]
  cardEvents     CardEvent[]
  wallet         Wallet?
  couponBalances CouponBalance[]
  recharges      Recharge[]
  redemptions    Redemption[]
  walletTxns     WalletTransaction[]
  couponTxns     CouponTransaction[]
  foodRequests   FoodRequest[]
  linkedStaff    AppUser[]           @relation("AppUserCardholder")

  @@index([branchId])
  @@index([categoryId])
  @@index([phone])
  @@map("users")
}

model RfidCard {
  id        BigInt     @id @default(autoincrement())
  cardUid   String     @unique @map("card_uid") @db.VarChar(64) // value the USB reader emits
  userId    BigInt     @map("user_id")
  status    CardStatus @default(active)
  issuedAt  DateTime?  @map("issued_at") @db.Timestamptz(6)
  expiresOn DateTime?  @map("expires_on") @db.Timestamptz(6)
  blockedAt DateTime?  @map("blocked_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id])
  cardEvents   CardEvent[]
  recharges    Recharge[]
  redemptions  Redemption[]
  foodRequests FoodRequest[]

  // One ACTIVE card per user → partial unique index added in migration SQL.
  @@index([userId])
  @@map("rfid_cards")
}

model CardEvent {
  id        BigInt        @id @default(autoincrement())
  cardId    BigInt?       @map("card_id")
  userId    BigInt        @map("user_id")
  type      CardEventType
  oldUid    String?       @map("old_uid") @db.VarChar(64)
  newUid    String?       @map("new_uid") @db.VarChar(64)
  reason    String?       @db.VarChar(255)
  appUserId BigInt?       @map("app_user_id")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  card    RfidCard? @relation(fields: [cardId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  appUser AppUser?  @relation(fields: [appUserId], references: [id])

  @@index([userId])
  @@index([cardId])
  @@map("card_events")
}

// ---------- Balances (cached; reconcilable from ledgers) ----------

model Wallet {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @unique @map("user_id")
  balanceAmount Decimal  @default(0) @map("balance_amount") @db.Decimal(12, 2)
  currency      String   @default("INR") @db.Char(3)
  version       Int      @default(0) // optimistic lock
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                @relation(fields: [userId], references: [id])
  WalletTransaction WalletTransaction[]

  @@map("wallets")
}

model CouponBalance {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  mealTypeId BigInt   @map("meal_type_id")
  count      Int      @default(0)
  version    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id])
  mealType MealType @relation(fields: [mealTypeId], references: [id])

  @@unique([userId, mealTypeId])
  @@map("coupon_balances")
}

// ---------- Catalog & pricing ----------

model MealType {
  id        BigInt  @id @default(autoincrement())
  code      String  @unique @db.VarChar(30)
  name      String  @db.VarChar(80)
  startTime String  @default("00:00") @map("start_time") @db.VarChar(5) // "HH:MM"; overnight handled in service
  endTime   String  @default("00:00") @map("end_time") @db.VarChar(5)
  active    Boolean @default(true)

  rates            MealRate[]
  couponBalances   CouponBalance[]
  rechargePlans    RechargePlan[]
  rechargeCoupons  RechargeCoupon[]
  redemptions      Redemption[]
  couponTxns       CouponTransaction[]
  counterMeals     CounterMeal[]
  foodItems        FoodItem[]
  foodRequestItems FoodRequestItem[]

  @@map("meal_types")
}

model MealRate {
  id         BigInt    @id @default(autoincrement())
  mealTypeId BigInt    @map("meal_type_id")
  categoryId BigInt    @map("category_id")
  branchId   BigInt    @map("branch_id")
  counterId  BigInt?   @map("counter_id") // NULL = branch-wide default; set = counter-specific override (resolved first at tap time)
  rate       Decimal   @db.Decimal(12, 2) // charged to cardholder (sale)
  vendorRate Decimal   @map("vendor_rate") @db.Decimal(12, 2) // paid to caterer (cost) → P/L = rate - vendorRate
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date // NULL = current
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  mealType MealType @relation(fields: [mealTypeId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  counter  Counter? @relation(fields: [counterId], references: [id])

  @@index([branchId, mealTypeId, categoryId, validFrom])
  @@index([counterId, mealTypeId, categoryId, validFrom])
  // Exactly one current (valid_to NULL) row per key is enforced by two partial
  // UNIQUE indexes added in migration 20260609140000_meal_rates_one_current
  // (partial indexes can't be expressed in the Prisma schema).
  @@map("meal_rates")
}

model RechargePlan {
  id         BigInt  @id @default(autoincrement())
  name       String  @db.VarChar(80)
  amount     Decimal @default(0) @db.Decimal(12, 2)
  bonus      Decimal @default(0) @db.Decimal(12, 2)
  mealCount  Int     @default(0) @map("meal_count")
  mealTypeId BigInt? @map("meal_type_id")
  active     Boolean @default(true)

  mealType  MealType?  @relation(fields: [mealTypeId], references: [id])
  recharges Recharge[]

  @@map("recharge_plans")
}

model PaymentMode {
  id     BigInt  @id @default(autoincrement())
  code   String  @unique @db.VarChar(30)
  name   String  @db.VarChar(60)
  active Boolean @default(true)

  recharges Recharge[]

  @@map("payment_modes")
}

// ---------- Money movements (ledgers) ----------

model Recharge {
  id              BigInt         @id @default(autoincrement())
  clientUuid      String         @unique @map("client_uuid") @db.Uuid // idempotency key
  userId          BigInt         @map("user_id")
  cardId          BigInt?        @map("card_id")
  planId          BigInt?        @map("plan_id")
  amount          Decimal        @default(0) @db.Decimal(12, 2) // money → wallet
  validFrom       DateTime?      @map("valid_from") @db.Date
  validTill       DateTime?      @map("valid_till") @db.Date
  remainingAmount Decimal        @default(0) @map("remaining_amount") @db.Decimal(12, 2) // unspent wallet money from THIS recharge
  paymentModeId   BigInt         @map("payment_mode_id")
  counterId       BigInt?        @map("counter_id")
  appUserId       BigInt?        @map("app_user_id") // operator; NULL = self-service / online top-up
  status          RechargeStatus @default(posted)
  remarks         String?        @db.VarChar(255)
  transactionId   String?        @map("transaction_id") @db.VarChar(120) // gateway transaction id (online top-ups)
  rechargedAt     DateTime       @default(now()) @map("recharged_at") @db.Timestamptz(6)
  editedAt        DateTime?      @map("edited_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id])
  card        RfidCard?        @relation(fields: [cardId], references: [id])
  plan        RechargePlan?    @relation(fields: [planId], references: [id])
  paymentMode PaymentMode      @relation(fields: [paymentModeId], references: [id])
  counter     Counter?         @relation(fields: [counterId], references: [id])
  appUser     AppUser?         @relation(fields: [appUserId], references: [id])
  coupons     RechargeCoupon[]

  @@index([userId, rechargedAt])
  @@map("recharges")
}

// One meal's coupon grant within a recharge (plan.md §5 — multi-meal grants).
// `remaining` tracks unspent coupons from this grant (FIFO-consumed at taps).
model RechargeCoupon {
  id         BigInt @id @default(autoincrement())
  rechargeId BigInt @map("recharge_id")
  mealTypeId BigInt @map("meal_type_id")
  count      Int    @default(0) // granted
  remaining  Int    @default(0) // unspent from this grant

  recharge Recharge @relation(fields: [rechargeId], references: [id], onDelete: Cascade)
  mealType MealType @relation(fields: [mealTypeId], references: [id])

  @@unique([rechargeId, mealTypeId])
  @@map("recharge_coupons")
}

model Redemption {
  id           BigInt           @id @default(autoincrement())
  clientUuid   String           @unique @map("client_uuid") @db.Uuid // idempotency key
  userId       BigInt           @map("user_id")
  cardId       BigInt           @map("card_id")
  mealTypeId   BigInt           @map("meal_type_id")
  counterId    BigInt           @map("counter_id")
  categoryId   BigInt?          @map("category_id") // snapshot
  paidBy       PaidBy?          @map("paid_by")
  rateApplied  Decimal          @map("rate_applied") @db.Decimal(12, 2) // meal value (revenue); reports use Σ rateApplied as Sale
  amount       Decimal          @db.Decimal(12, 2) // cash debited at the tap; 0 when paid_by = coupon (prepaid at recharge)
  vendorAmount Decimal          @default(0) @map("vendor_amount") @db.Decimal(12, 2) // cost snapshot → P/L = rateApplied - vendorAmount
  appUserId     BigInt           @map("app_user_id") // operator
  foodRequestId BigInt?          @map("food_request_id") // set when this row came from a fulfilled food request
  status        RedemptionStatus @default(posted)
  redeemedAt    DateTime         @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  syncedAt      DateTime?        @map("synced_at") @db.Timestamptz(6) // set when an offline tap is synced

  user        User         @relation(fields: [userId], references: [id])
  card        RfidCard     @relation(fields: [cardId], references: [id])
  mealType    MealType     @relation(fields: [mealTypeId], references: [id])
  counter     Counter      @relation(fields: [counterId], references: [id])
  appUser     AppUser      @relation(fields: [appUserId], references: [id])
  foodRequest FoodRequest? @relation(fields: [foodRequestId], references: [id])

  @@index([userId, redeemedAt])
  @@index([counterId, redeemedAt])
  @@index([mealTypeId, redeemedAt])
  @@index([foodRequestId])
  @@map("redemptions")
}

model WalletTransaction {
  id           BigInt       @id @default(autoincrement())
  walletId     BigInt       @map("wallet_id")
  userId       BigInt       @map("user_id")
  txnType      TxnType      @map("txn_type")
  sourceTable  LedgerSource @map("source_table")
  sourceId     BigInt       @map("source_id")
  amount       Decimal      @db.Decimal(12, 2)
  balanceAfter Decimal      @map("balance_after") @db.Decimal(12, 2)
  reference    String?      @db.VarChar(120)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model CouponTransaction {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt       @map("user_id")
  mealTypeId   BigInt       @map("meal_type_id")
  txnType      TxnType      @map("txn_type")
  sourceTable  LedgerSource @map("source_table")
  sourceId     BigInt       @map("source_id")
  count        Int
  balanceAfter Int          @map("balance_after")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id])
  mealType MealType @relation(fields: [mealTypeId], references: [id])

  @@index([userId, createdAt])
  @@map("coupon_transactions")
}

model Reversal {
  id          BigInt         @id @default(autoincrement())
  sourceTable ReversalSource @map("source_table")
  sourceId    BigInt         @map("source_id")
  reason      String         @db.VarChar(255)
  requestedBy BigInt         @map("requested_by")
  status      ReversalStatus @default(pending)
  approvedBy  BigInt?        @map("approved_by")
  approvedAt  DateTime?      @map("approved_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  requester AppUser  @relation("ReversalRequestedBy", fields: [requestedBy], references: [id])
  approver  AppUser? @relation("ReversalApprovedBy", fields: [approvedBy], references: [id])

  @@index([sourceTable, sourceId])
  @@map("reversals")
}

// ---------- Vendor settlement ----------

model Vendor {
  id                BigInt       @id @default(autoincrement())
  code              String       @unique @db.VarChar(30)
  name              String       @db.VarChar(150)
  gstin             String?      @db.VarChar(20)
  phone             String?      @db.VarChar(20)
  email             String?      @db.VarChar(150)
  address           String? // free-text postal address
  bankName          String?      @map("bank_name") @db.VarChar(150)
  bankAccountName   String?      @map("bank_account_name") @db.VarChar(150) // account holder
  bankAccountNumber String?      @map("bank_account_number") @db.VarChar(40)
  bankIfsc          String?      @map("bank_ifsc") @db.VarChar(20)
  notes             String? // free-text vendor details / remarks
  appUserId         BigInt?      @unique @map("app_user_id") // the staff login (Vendor role) that operates this vendor's portal
  status            BranchStatus @default(active)

  appUser      AppUser?           @relation("VendorPortalOperator", fields: [appUserId], references: [id])
  staff        AppUser[]          @relation("VendorStaff") // staff (Vendor / Mess Incharge) attached to this vendor
  settlements  VendorSettlement[]
  foodRequests FoodRequest[]

  @@map("vendors")
}

model VendorSettlement {
  id          BigInt           @id @default(autoincrement())
  vendorId    BigInt           @map("vendor_id")
  branchId    BigInt           @map("branch_id")
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date
  mealCount   Int              @default(0) @map("meal_count")
  grossAmount Decimal          @default(0) @map("gross_amount") @db.Decimal(12, 2)
  status      SettlementStatus @default(draft)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@map("vendor_settlements")
}

// Managed delivery locations for food requests (Settings → Delivery Locations).
// The request stores the chosen location as text; this curates the searchable
// suggestions shown on the raise-request form.
model DeliveryLocation {
  id        BigInt       @id @default(autoincrement())
  name      String       @db.VarChar(150)
  branchId  BigInt?      @map("branch_id") // NULL = all branches
  status    BranchStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@map("delivery_locations")
}

// A self-service online top-up (Jodo). Created when the pay order is placed;
// the coupons are only credited once Jodo confirms `paid` (get-order), keyed by
// `clientUuid` for idempotency. `items` = [{ mealTypeId, qty }].
model PaymentOrder {
  id          BigInt    @id @default(autoincrement())
  jodoOrderId String    @unique @map("jodo_order_id") @db.VarChar(512)
  clientUuid  String    @unique @map("client_uuid") @db.Uuid // reused as the credited recharge's idempotency key
  userId      BigInt    @map("user_id")
  branchId    BigInt    @map("branch_id")
  amount      Decimal   @db.Decimal(12, 2)
  items       Json
  status      String    @default("pending") @db.VarChar(20) // pending | credited | failed
  rechargeId  BigInt?   @map("recharge_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  creditedAt  DateTime? @map("credited_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("payment_orders")
}

// ---------- Admin food requests (plan.md §15) ----------

// Catalog of orderable items. CATALOG-ONLY pricing: the charged amount and the
// vendor cost (for P/L) always come from here — even "Custom Items" resolve to a
// catalog row. `mealTypeId` is the representative meal used to group a fulfilled
// request's redemption rows in reports (beverages/custom map to inactive meal
// types so they never become tappable at a real counter).
model FoodItem {
  id              BigInt       @id @default(autoincrement())
  code            String       @unique @db.VarChar(30)
  name            String       @db.VarChar(120)
  kind            FoodItemKind @default(meal)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(12, 2) // charged to the RFID account (sale)
  unitVendorPrice Decimal      @map("unit_vendor_price") @db.Decimal(12, 2) // paid to the vendor (cost)
  mealTypeId      BigInt       @map("meal_type_id") // representative meal for redemption grouping
  branchId        BigInt?      @map("branch_id") // NULL = all-branch
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  mealType     MealType          @relation(fields: [mealTypeId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  requestItems FoodRequestItem[]

  @@index([branchId])
  @@map("food_items")
}

// A food request raised by an admin against a cardholder's RFID account. Money is
// only moved at delivery, server-side, gated by an RFID tap (see services in
// Phase E). `amount`/`vendorAmount` are snapshots of the catalog totals at the
// time the request was raised; the wallet is debited for `amount` on fulfilment.
model FoodRequest {
  id                   BigInt            @id @default(autoincrement())
  code                 String            @unique @db.VarChar(30) // human ref e.g. FR-000123
  branchId             BigInt            @map("branch_id")
  userId               BigInt            @map("user_id") // the RFID account charged
  requestedByAppUserId BigInt            @map("requested_by_app_user_id")
  vendorId             BigInt?           @map("vendor_id")
  deliveryLocation     String            @map("delivery_location") @db.VarChar(150)
  requestedFor         DateTime          @map("requested_for") @db.Timestamptz(6) // requested delivery date & time
  purpose              String?           @db.VarChar(255) // remarks / purpose
  status               FoodRequestStatus @default(raised)
  amount               Decimal           @default(0) @db.Decimal(12, 2) // snapshot sale total (Σ qty × unitPrice)
  vendorAmount         Decimal           @default(0) @map("vendor_amount") @db.Decimal(12, 2) // snapshot cost total
  approvalRequired     Boolean           @default(false) @map("approval_required") // snapshot of the setting at creation
  approvedByAppUserId  BigInt?           @map("approved_by_app_user_id")
  approvedAt           DateTime?         @map("approved_at") @db.Timestamptz(6)
  rejectReason         String?           @map("reject_reason") @db.VarChar(255)
  fulfilledClientUuid  String?           @unique @map("fulfilled_client_uuid") @db.Uuid // idempotency for the delivery charge
  cardIdUsed           BigInt?           @map("card_id_used") // card tapped at delivery (RFID verification)
  deliveredAt          DateTime?         @map("delivered_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch      Branch             @relation(fields: [branchId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  requestedBy AppUser            @relation("FoodRequestRequestedBy", fields: [requestedByAppUserId], references: [id])
  approvedBy  AppUser?           @relation("FoodRequestApprovedBy", fields: [approvedByAppUserId], references: [id])
  vendor      Vendor?            @relation(fields: [vendorId], references: [id])
  cardUsed    RfidCard?          @relation(fields: [cardIdUsed], references: [id])
  items       FoodRequestItem[]
  events      FoodRequestEvent[]
  redemptions Redemption[]

  @@index([branchId, status])
  @@index([userId])
  @@index([vendorId, status])
  @@index([requestedByAppUserId])
  @@map("food_requests")
}

// One line on a request. Prices are snapshotted from the catalog at creation so
// later catalog edits never change a historical request's charge.
model FoodRequestItem {
  id              BigInt  @id @default(autoincrement())
  requestId       BigInt  @map("request_id")
  foodItemId      BigInt  @map("food_item_id")
  mealTypeId      BigInt  @map("meal_type_id") // snapshot from the item (redemption grouping)
  description     String? @db.VarChar(255) // free text, e.g. the specifics of a Custom Item
  qty             Int     @default(1)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2) // snapshot
  unitVendorPrice Decimal @map("unit_vendor_price") @db.Decimal(12, 2) // snapshot

  request  FoodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  foodItem FoodItem    @relation(fields: [foodItemId], references: [id])
  mealType MealType    @relation(fields: [mealTypeId], references: [id])

  @@index([requestId])
  @@map("food_request_items")
}

// Append-only status history → drives the request timeline and the audit trail.
model FoodRequestEvent {
  id         BigInt             @id @default(autoincrement())
  requestId  BigInt             @map("request_id")
  fromStatus FoodRequestStatus? @map("from_status")
  toStatus   FoodRequestStatus  @map("to_status")
  note       String?            @db.VarChar(255)
  appUserId  BigInt?            @map("app_user_id")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  request FoodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  appUser AppUser?    @relation(fields: [appUserId], references: [id])

  @@index([requestId])
  @@map("food_request_events")
}

// ---------- Ops: offline, audit, notifications, settings ----------

model OfflineQueue {
  id          BigInt             @id @default(autoincrement())
  deviceId    String             @map("device_id") @db.VarChar(80)
  clientUuid  String             @unique @map("client_uuid") @db.Uuid
  payloadJson Json               @map("payload_json") @db.JsonB
  status      OfflineQueueStatus @default(pending)
  syncedAt    DateTime?          @map("synced_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("offline_queue")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  appUserId  BigInt?  @map("app_user_id")
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   BigInt?  @map("entity_id")
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appUser AppUser? @relation(fields: [appUserId], references: [id])

  @@index([entity, entityId])
  @@index([appUserId, createdAt])
  @@map("audit_log")
}

model Notification {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(40)
  audience    String    @db.VarChar(60)
  payloadJson Json      @map("payload_json") @db.JsonB
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type])
  @@map("notifications")
}

model Setting {
  settingKey String   @id @map("setting_key") @db.VarChar(60)
  value      Json     @db.JsonB
  branchId   BigInt?  @map("branch_id") // NULL = global; set = per-branch override
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@map("settings")
}

// ---------- Notifications module (Super Admin — plan: Notifications Management) ----------

enum NotificationChannel {
  push
  email
  whatsapp
}

enum NotificationFrequency {
  instant
  daily_digest
}

enum NotificationLogStatus {
  pending
  sent
  failed
  skipped
}

// Per event × channel delivery rule, edited from the Notifications Management
// pages. The event catalog itself is code (services/notification-events.ts) so
// new events ship with features; rules/templates are data so behaviour is
// configurable without deployments.
model NotificationRule {
  id         BigInt                @id @default(autoincrement())
  eventCode  String                @map("event_code") @db.VarChar(60)
  channel    NotificationChannel
  enabled    Boolean               @default(false)
  // Recipient config: { roles?: string[], vendor?: bool, requester?: bool, cardholder?: bool }
  recipients Json                  @default("{}")
  frequency  NotificationFrequency @default(instant)
  templateId BigInt?               @map("template_id")
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@unique([eventCode, channel])
  @@map("notification_rules")
}

// Channel templates with {{variable}} placeholders (variables come from the
// event catalog). WhatsApp rows also carry the approved Business template id +
// the ordered variable mapping (Smartping), so templates update from the portal
// without code changes.
model NotificationTemplate {
  id           BigInt              @id @default(autoincrement())
  channel      NotificationChannel
  name         String              @db.VarChar(120)
  title        String?             @db.VarChar(200) // push title / email subject; unused for WhatsApp
  body         String
  waTemplateId String?             @map("wa_template_id") @db.VarChar(120) // approved WhatsApp template NAME (synced from the Partner API)
  waLanguage   String?             @map("wa_language") @db.VarChar(10) // template language code (e.g. en, en_US) — required by the send API
  waVariables  Json?               @map("wa_variables") // positional markers ["1".."N"] — the template's param count (display only)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  rules NotificationRule[]

  @@map("notification_templates")
}

// Email sending identity (Pallavi / DPS). Branches map to an entity; mail about
// a cardholder goes out via their branch's entity domain. SMTP credentials stay
// in env under SMTP_<envPrefix>_* — only the pointer is stored here.
model EmailEntity {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  fromName  String   @map("from_name") @db.VarChar(120)
  fromEmail String   @map("from_email") @db.VarChar(150)
  envPrefix String   @unique @map("env_prefix") @db.VarChar(40) // SMTP_<PREFIX>_HOST/PORT/USER/PASS
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches Branch[]

  @@map("email_entities")
}

// Browser Web-Push subscription for a staff/vendor login (PWA).
model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  appUserId BigInt   @map("app_user_id")
  endpoint  String   @unique @db.VarChar(1024)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId])
  @@map("push_subscriptions")
}

// Outbox/audit of every notification the dispatcher produced. Senders flip
// pending → sent/failed; `skipped` = channel not configured (no creds) at send
// time. Append-only.
model NotificationLog {
  id        BigInt                @id @default(autoincrement())
  eventCode String                @map("event_code") @db.VarChar(60)
  channel   NotificationChannel
  recipient String                @db.VarChar(255) // email / phone / app_user:<id>
  title     String?               @db.VarChar(200)
  body      String
  // Channel payload needed to (re)send later — email: {envPrefix,fromName,fromEmail};
  // whatsapp: {waTemplateId,variables}. Lets the daily-digest sweep flush pending rows.
  meta      Json?
  status    NotificationLogStatus @default(pending)
  error     String?               @db.VarChar(500)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?             @map("sent_at") @db.Timestamptz(6)

  @@index([eventCode, channel])
  @@index([createdAt])
  @@map("notification_logs")
}
