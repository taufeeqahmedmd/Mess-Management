# Normalize line endings: store text as LF in the repo, check out native on Windows.
* text=auto eol=lf

# Always LF for these regardless of platform
*.md   text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.prisma text eol=lf

# Treat as binary (no EOL conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
